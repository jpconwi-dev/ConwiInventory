# Neon connection string (Dashboard > Connect). Keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Your Vercel URL(s), comma separated
CORS_ORIGINS=http://localhost:5173
# Set this to your Neon plan's storage limit (MB). Free plan = 512
STORAGE_LIMIT_MB=512
APP_TIMEZONE=Asia/Manila
